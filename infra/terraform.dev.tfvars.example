# Dev environment. Copy to terraform.dev.tfvars (gitignored) and fill in.
# Deploy in a dedicated workspace so dev/prod state never collide:
#   terraform workspace select dev || terraform workspace new dev
#   terraform apply -var-file=terraform.dev.tfvars

aws_region  = "us-east-1"
name_prefix = "fateround-dev"

# Smaller footprint for dev.
instance_type = "t3.small"
app_port      = 3000

app_image_tag = "latest"

# From your DEV Supabase branch (Supabase Branching -> persistent `dev` branch).
supabase_url      = "https://YOUR-DEV-PROJECT.supabase.co"
supabase_anon_key = "REPLACE_WITH_DEV_ANON_KEY"
cron_secret       = "REPLACE_WITH_DEV_CRON_SECRET"

tick_interval_seconds = 60

# Cloudflare. The token is read from the CLOUDFLARE_API_TOKEN env var
# (kept in ~/.config/shell/secrets.sh), NOT here.
cloudflare_enabled     = true
cloudflare_zone_id     = "fff141dbd5d5f15aadf4497bcd46f3fc" # fateround.com zone
cloudflare_record_name = "dev"                              # -> dev.fateround.com
cloudflare_proxied     = true
# restrict_to_cloudflare = true   # optional: lock the instance SG to Cloudflare IPs

# App env. All of these except the NEXT_PUBLIC_* values are secrets stored in SSM.
next_public_app_url       = "https://dev.fateround.com"   # prod example: "https://fateround.com"
next_public_livekit_url   = "wss://YOUR-LIVEKIT-HOST"
supabase_service_role_key = "REPLACE_WITH_SERVICE_ROLE_KEY"
admin_email               = "admin@fateround.com"
admin_password            = "REPLACE_WITH_ADMIN_PASSWORD"
admin_session_secret      = "REPLACE_WITH_SESSION_SECRET"
klipy_api_key             = "REPLACE_WITH_KLIPY_KEY"
livekit_api_key           = "REPLACE_WITH_LIVEKIT_KEY"
livekit_api_secret        = "REPLACE_WITH_LIVEKIT_SECRET"

# Web push (optional). Generate a keypair with `pnpm vapid:generate`; put the PUBLIC
# key in the CI build workflow (build-push-image.yml) and the PRIVATE key here. Leave
# both empty to keep push off. vapid_subject is a mailto:/https: contact URL.
vapid_private_key = "REPLACE_WITH_VAPID_PRIVATE_KEY"
vapid_subject     = "mailto:hello@fateround.com"

# In-game Spotify music (optional). The client id is public and lives in the CI build
# workflow (build-push-image.yml); put the matching client SECRET here. Leave empty to
# keep music off. Register redirect URI ${next_public_app_url}/api/spotify/callback in
# the Spotify dashboard (Spotify disallows localhost — use 127.0.0.1 for local dev).
spotify_client_secret = "REPLACE_WITH_SPOTIFY_CLIENT_SECRET"
