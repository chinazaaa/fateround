# Prod environment. Copy to terraform.prod.tfvars (gitignored) and fill in.
# Deploy in a dedicated workspace so dev/prod state never collide:
#   terraform workspace select prod || terraform workspace new prod
#   terraform apply -var-file=terraform.prod.tfvars

aws_region  = "us-east-1"
name_prefix = "fateround-prod"

instance_type = "t3.small"
app_port      = 3000

app_image_tag = "latest"

# From your PRODUCTION Supabase branch (the live project).
supabase_url      = "https://YOUR-PROD-PROJECT.supabase.co"
supabase_anon_key = "REPLACE_WITH_PROD_ANON_KEY"
cron_secret       = "REPLACE_WITH_PROD_CRON_SECRET"

tick_interval_seconds = 60

# Cloudflare. Token via CLOUDFLARE_API_TOKEN env, not here.
cloudflare_enabled     = true
cloudflare_zone_id     = "fff141dbd5d5f15aadf4497bcd46f3fc" # fateround.com zone
cloudflare_record_name = "@"                                # -> fateround.com (apex)
cloudflare_proxied     = true
restrict_to_cloudflare = true # lock the origin to Cloudflare's edge IPs
# NOTE: fateround.com may already have a Cloudflare record (current prod). Before
# applying prod, delete/repoint that record or `terraform import` it into
# cloudflare_record.app[0] so this stack doesn't conflict with it.

# TLS: with the record proxied, use Cloudflare SSL "Full" and put a free
# Cloudflare Origin Certificate on the box for end-to-end encryption.

# App env. All of these except the NEXT_PUBLIC_* values are secrets stored in SSM.
next_public_app_url       = "https://fateround.com"   # prod example: "https://fateround.com"
next_public_livekit_url   = "wss://YOUR-LIVEKIT-HOST"
supabase_service_role_key = "REPLACE_WITH_SERVICE_ROLE_KEY"
admin_email               = "admin@fateround.com"
admin_password            = "REPLACE_WITH_ADMIN_PASSWORD"
admin_session_secret      = "REPLACE_WITH_SESSION_SECRET"
klipy_api_key             = "REPLACE_WITH_KLIPY_KEY"
livekit_api_key           = "REPLACE_WITH_LIVEKIT_KEY"
livekit_api_secret        = "REPLACE_WITH_LIVEKIT_SECRET"

# Web push. Reusing the same VAPID keypair as dev (its PUBLIC key is already in the
# CI build workflow's prod block). Put the matching PRIVATE key here, plus a contact
# subject (mailto:/https:). Leave empty to keep push off on prod.
vapid_private_key = "REPLACE_WITH_VAPID_PRIVATE_KEY"
vapid_subject     = "mailto:hello@fateround.com"

# In-game Spotify music (optional). The client id is public and lives in the CI build
# workflow (build-push-image.yml); put the matching client SECRET here. Leave empty to
# keep music off. Register redirect URI ${next_public_app_url}/api/spotify/callback in
# the Spotify dashboard.
spotify_client_secret = "REPLACE_WITH_SPOTIFY_CLIENT_SECRET"

# AI deck generation (optional). Server-side Claude key used by /create's "Generate
# with AI" — hosts no longer paste their own key, so THIS key pays for every
# generation. Leave empty to keep AI generation off (the route returns 503 and the
# option is inert). Metered spend: the hard ceiling is the app-wide daily cap in
# src/lib/rate-limit.ts (aiQuestionsGlobalDaily, override with the container env
# var AI_QUESTIONS_GLOBAL_DAILY_MAX). That is a backstop, not a budget — set a
# spend alert on the Anthropic account before pointing real traffic at it.
anthropic_api_key = "REPLACE_WITH_ANTHROPIC_API_KEY"

# OpenTelemetry export (optional). Leave the endpoint empty to keep telemetry off —
# the app's src/instrumentation.ts no-ops without it. To turn it on, create a Grafana
# Cloud (or other OTLP) stack and fill in the endpoint + auth header.
#   endpoint: OTLP/HTTP gateway URL (Grafana Cloud: https://otlp-gateway-<region>.grafana.net/otlp)
#   headers:  backend auth, e.g. Authorization=Basic <base64(instanceID:token)>  (keep out of git;
#             prefer TF_VAR_otel_exporter_otlp_headers in your shell secrets over a value here)
#   resource_attributes: labels stamped on every span/metric (service.name defaults to "fateround")
otel_exporter_otlp_endpoint = ""
otel_exporter_otlp_headers  = ""
otel_resource_attributes    = "deployment.environment=prod"

# Origin TLS (Caddy + Cloudflare Origin Certificate) for Full (strict).
# The cert + key are NOT placed here — export them as TF_VAR_origin_cert /
# TF_VAR_origin_key (e.g. in ~/.config/shell/secrets.sh) so they never touch a file.
enable_origin_tls = true
