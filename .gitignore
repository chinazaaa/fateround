# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# expo / mobile
apps/mobile/.expo/
apps/mobile/dist/
# No trailing slash: with one, this matches a DIRECTORY only, so a symlink named
# `apps/mobile/node_modules` slips past it and `git add -A` commits a machine-specific
# absolute path. That happened once (caught in review on #866).
apps/mobile/node_modules
CLAUDE.md
.venv
.claude/*
# `pr-workflow` is the team's shared process, so it is tracked deliberately rather than
# force-added past this ignore. Everything else under .claude/ (worktrees, local settings, the
# terraform-* and worktree-cleanup skills) stays local.
#
# Re-including a path inside an ignored directory needs the parents un-ignored one level at a
# time -- git never descends into an excluded directory, so `!.claude/skills/pr-workflow/` alone
# would not work.
!.claude/skills/
.claude/skills/*
!.claude/skills/pr-workflow/
.worktrees/

# local MCP server config
.mcp.json
