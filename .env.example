NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side Claude key used to generate custom question decks from /create.
# Callers no longer supply their own key; requests are capped per IP (see
# RATE_LIMITS.aiQuestions* in src/lib/rate-limit.ts) so a runaway script can't
# drain the budget. Leave blank in local dev to disable AI generation.
ANTHROPIC_API_KEY=
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Web push notifications. Generate a keypair with `pnpm vapid:generate`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# In-game Spotify music. Create an app at https://developer.spotify.com/dashboard,
# and register the redirect URI ${NEXT_PUBLIC_APP_URL}/api/spotify/callback
# (e.g. http://localhost:3000/api/spotify/callback for local dev).
# The client id is public (PKCE); the secret is server-only.
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=