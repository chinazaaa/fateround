NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side Claude key used to generate custom question decks from /create.
# Callers no longer supply their own key, so THIS key pays for every generation.
# Leave blank in local dev to disable AI generation (the route returns 503).
ANTHROPIC_API_KEY=

# Hard ceiling on AI generations per rolling 24h ACROSS THE WHOLE APP (default 200).
# The per-IP limits in src/lib/rate-limit.ts can't bound total spend — a caller
# cycling IPs gets a fresh per-IP allowance each time — so this global counter is
# the real cap. Lower it to throttle spend; raise it once billing gates usage.
# Not a substitute for a spend alert on the Anthropic account itself.
AI_QUESTIONS_GLOBAL_DAILY_MAX=
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Web push notifications. Generate a keypair with `pnpm vapid:generate`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# In-game Spotify music. Create an app at https://developer.spotify.com/dashboard,
# and register the redirect URI ${NEXT_PUBLIC_APP_URL}/api/spotify/callback
# (e.g. http://localhost:3000/api/spotify/callback for local dev).
# The client id is public (PKCE); the secret is server-only.
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=